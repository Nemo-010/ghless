#!/bin/sh
# ghless: the single entry point of ghless.
set -u
if ! readlink -f "$0" >/dev/null 2>&1; then
  echo "ghless: error: ghless requires Linux (GNU or busybox coreutils): readlink -f is not available" >&2
  exit 1
fi
GHLESS_HOME=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
export GHLESS_HOME

usage() {
  cat <<'U'
ghless: read, work on, publish and archive code with no GitHub account.

Quickstart:
  ghless doctor                     check this host, install anything missing
  ghless read owner/repo            print a README without cloning
  ghless fetch owner/repo           clone + work branch, prints the path
  ghless publish <dir>              push to every lane that works, verified
  ghless status --check             what every host serves right now

Commands:
  ghless doctor [--brief|--json]     what works on this host (tools, egress, lanes)
  ghless read SPEC [PATH] [REF]      print one file or the README of a public repo
  ghless fetch SPEC [DIR]            clone any public repo, make a work branch
  ghless work SPEC [DIR]             same as fetch
  ghless publish [DIR] [--name N] [--lanes a,b] [--desc TEXT] [--dry-run] [--no-verify]
                                     push to github (if authenticated), radicle, nostr, arweave
  ghless push [DIR] [--private] [--license ID] [--name N]
                                     only when the user says "push": github if the login works
                                     (public, 0BSD by default), else radicle/nostr/arweave + archive + tunnel + zip
  ghless archive [DIR] [--name N] [--out DIR] [--no-net] [--deep] [--wait]
                                     [--public-url URL ...] [--extra PATH ...]
                                     bundles + patches + zip, SWH and Wayback requests
  ghless serve [--json] [NAME=PATH ...]
                                     site over a temporary cfrs tunnel (--status, --stop)
  ghless pack [OUT.zip]              zip ghless itself
  ghless status [--check|--json]     what was published where (--check asks the hosts)
  ghless identity [show|init|export FILE|import FILE]
                                     mint, show, back up or restore the identities
  ghless tools [install|status]      pinned binaries (cfrs, rad, nak, ngit, git-remote-arweave)
  ghless update-check                compare pins against upstream releases (read only)
  ghless completion bash|zsh         shell completion script
  ghless COMMAND --help              the full usage of one command

SPEC is owner/repo, a github.com URL (tree/blob URLs included) or any git URL.
Also on PATH: gh (real gh first, read-only forge fallback), ghre, bulk-archive.
Docs: ghless/README.md, docs/, skill/ghless/SKILL.md
U
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  doctor|read|fetch|publish|push|archive|serve|pack|identity|tools|update-check|status|completion|work)
    case "${1:-}" in
      -h|--help)
        f="$GHLESS_HOME/libexec/$cmd"; [ "$cmd" = work ] && f="$GHLESS_HOME/libexec/fetch"
        awk 'NR==1{next} /^#/{sub(/^# ?/,""); print; next} {exit}' "$f"; exit 0 ;;
    esac ;;
esac
case "$cmd" in
  help|-h|--help) usage ;;
  --version|version) cat "$GHLESS_HOME/VERSION" ;;
  doctor|read|fetch|publish|push|archive|serve|pack|identity|tools|update-check|status|completion)
    exec "$GHLESS_HOME/libexec/$cmd" "$@" ;;
  work) exec "$GHLESS_HOME/libexec/fetch" "$@" ;;
  *) usage >&2; echo "ghless: unknown command: $cmd" >&2; exit 2 ;;
esac
