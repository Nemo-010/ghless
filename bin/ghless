#!/bin/sh
# ghless: the single entry point of ghless.
set -u
GHLESS_HOME=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
export GHLESS_HOME

usage() {
  cat <<'U'
ghless: read, work on, publish and archive code with no GitHub account.

  ghless doctor [--brief]            what works on this host (tools, egress, lanes)
  ghless read SPEC [PATH] [REF]      print one file or the README of a public repo
  ghless fetch SPEC [DIR]            clone any public repo, make a work branch
  ghless work SPEC [DIR]             same as fetch
  ghless publish [DIR] [--name N] [--lanes a,b]
                                     push to github (if authenticated), radicle, nostr, arweave
  ghless archive [DIR] [--no-net]    bundles + patches + zip, SWH and Wayback requests
  ghless serve [NAME=PATH ...]       git web index over a temporary cfrs tunnel (--status, --stop)
  ghless pack [OUT.zip]              zip ghless itself
  ghless identity [show|init]        mint or show the radicle, nostr and arweave identities
  ghless tools [install|status]      pinned binaries (cfrs, rad, nak, ngit, git-remote-arweave)
  ghless update-check                compare pins against upstream releases (read only)

SPEC is owner/repo, a github.com URL (tree/blob URLs included) or any git URL.
Also on PATH: gh (real gh first, read-only forge fallback), ghre, bulk-archive.
Docs: ghless/README.md, docs/, skill/ghless/SKILL.md
U
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  help|-h|--help) usage ;;
  --version|version) cat "$GHLESS_HOME/VERSION" ;;
  doctor|read|fetch|publish|archive|serve|pack|identity|tools|update-check)
    exec "$GHLESS_HOME/libexec/$cmd" "$@" ;;
  work) exec "$GHLESS_HOME/libexec/fetch" "$@" ;;
  *) usage >&2; echo "ghless: unknown command: $cmd" >&2; exit 2 ;;
esac
