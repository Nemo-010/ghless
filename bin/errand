#!/bin/sh
# errand: the single entry point of errand-home.
set -u
ERRAND_HOME=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
export ERRAND_HOME

usage() {
  cat <<'U'
errand: read, work on, publish and archive code with no GitHub account.

  errand doctor [--brief]            what works on this host (tools, egress, lanes)
  errand read SPEC [PATH] [REF]      print one file or the README of a public repo
  errand fetch SPEC [DIR]            clone any public repo, make a work branch
  errand work SPEC [DIR]             same as fetch
  errand publish [DIR] [--name N] [--lanes a,b]
                                     push to github (if authenticated), radicle, nostr, arweave
  errand archive [DIR] [--no-net]    bundles + patches + zip, SWH and Wayback requests
  errand serve [NAME=PATH ...]       git web index over a temporary cfrs tunnel (--status, --stop)
  errand pack [OUT.zip]              zip errand-home itself
  errand identity [show|init]        mint or show the radicle, nostr and arweave identities
  errand tools [install|status]      pinned binaries (cfrs, rad, nak, ngit, git-remote-arweave)
  errand update-check                compare pins against upstream releases (read only)

SPEC is owner/repo, a github.com URL (tree/blob URLs included) or any git URL.
Also on PATH: gh (real gh first, read-only forge fallback), ghre, bulk-archive.
Docs: errand-home/README.md, docs/, skill/errand-home/SKILL.md
U
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  help|-h|--help) usage ;;
  --version|version) cat "$ERRAND_HOME/VERSION" ;;
  doctor|read|fetch|publish|archive|serve|pack|identity|tools|update-check)
    exec "$ERRAND_HOME/libexec/$cmd" "$@" ;;
  work) exec "$ERRAND_HOME/libexec/fetch" "$@" ;;
  *) usage >&2; echo "errand: unknown command: $cmd" >&2; exit 2 ;;
esac
