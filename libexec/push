#!/bin/sh
# push: the whole "push it" routine, decided by the state of the GitHub account.
#   ghless push [DIR] [--name N] [--private] [--license ID] [--holder TEXT] [--desc TEXT] [--no-net] [--dry-run]
# Run it only when the user asked to push. What happens:
#   github login works, public (default)  license, github, mirror to radicle + nostr +
#                                         arweave, archive job, zip (no cfrs page)
#   github login works, --private         license, private github repo, stop
#   no working login,   --private         zip of HEAD only, nothing leaves this machine
#   no working login,   public            license, mirror, archive job, cfrs tunnel page, zip
# A repository with no LICENSE file gets one (default 0BSD; also MIT, ISC or any
# key api.github.com/licenses knows) committed on the current branch. An existing
# license file is never replaced. The last output lines are a fixed summary.
set -u
GHLESS_HOME="${GHLESS_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
. "$GHLESS_HOME/libexec/common.sh"

DIR=""; NAME=""; PRIVATE=0; LICENSE_ID=""; HOLDER=""; DESC=""; NET=1; DRY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --private) PRIVATE=1 ;;
    --no-net) NET=0 ;;
    --dry-run) DRY=1 ;;
    --name|--license|--holder|--desc) [ $# -ge 2 ] || die "$1 needs a value"
      case "$1" in --name) NAME="$2" ;; --license) LICENSE_ID="$2" ;; --holder) HOLDER="$2" ;; --desc) DESC="$2" ;; esac
      shift ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option: $1 (try --help)" ;;
    *) DIR="$1" ;;
  esac
  shift
done
DIR="$(cd "${DIR:-.}" 2>/dev/null && pwd -P)" || die "no such directory: ${DIR:-.}"
git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 || die "$DIR is not a git repository"
git -C "$DIR" rev-parse --verify -q HEAD >/dev/null || die "$DIR has no commits to push"
[ -n "$NAME" ] || NAME=$(git -C "$DIR" config --get ghless.name 2>/dev/null || true)
[ -n "$NAME" ] || NAME=$(basename "$DIR")
valid_name "$NAME" || die "bad name '$NAME': letters, digits, . _ -, not starting with . or -; pass --name"
[ -n "$HOLDER" ] || HOLDER="the $NAME authors"
LICENSE_KEY=$(printf '%s' "${LICENSE_ID:-0BSD}" | tr 'A-Z' 'a-z')
case "$LICENSE_KEY" in *[!a-z0-9.+-]*|"") die "bad license id: $LICENSE_ID" ;; esac

if github_authed; then GH=active; else GH=inactive; fi
if [ "$GH" = active ]; then
  if [ "$PRIVATE" = 1 ]; then PLAN="license; github private; stop"; else PLAN="license; github public; mirror to radicle, nostr, arweave; archive job; zip (no cfrs page)"; fi
elif [ "$PRIVATE" = 1 ]; then
  PLAN="zip only (no working GitHub login, private)"
else
  PLAN="license; radicle, nostr, arweave; archive job; cfrs tunnel page; zip (no working GitHub login)"
fi
VIS=public; [ "$PRIVATE" = 1 ] && VIS=private
if [ "$DRY" = 1 ]; then
  say "dry run for $NAME: github=$GH visibility=$VIS license=${LICENSE_ID:-0BSD}"
  say "plan: $PLAN"
  exit 0
fi
say "github=$GH visibility=$VIS: $PLAN"

LEDGER="$GHLESS_DATA/published.tsv"
BEFORE=0; [ -f "$LEDGER" ] && BEFORE=$(wc -l < "$LEDGER")
LOGDIR="$GHLESS_DATA/push-logs"; mkdir -p "$LOGDIR"
LOG="$LOGDIR/$NAME-$(date -u +%Y%m%dT%H%M%SZ).log"
: > "$LOG"
FAILED=""
LICENSE_NOTE=""

# step LABEL CMD...: run one stage, keep its output in the log, remember failures.
step() {
  _label="$1"; shift
  say "$_label"
  { printf '\n== %s\n' "$_label"; "$@"; } >> "$LOG" 2>&1
  _rc=$?
  [ "$_rc" -eq 0 ] || { FAILED="$FAILED $_label"; warn "$_label failed (exit $_rc); see $LOG"; }
  return 0
}

license_file() { # print the name of a license file tracked at HEAD, empty if none
  git -C "$DIR" ls-tree --name-only HEAD | grep -iE '^(licen[cs]e|copying|unlicense)(\.[A-Za-z]+)?$' | head -n1
}

ensure_license() {
  have_file=$(license_file)
  if [ -n "$have_file" ]; then
    LICENSE_NOTE="kept existing $have_file"
    [ -z "$LICENSE_ID" ] || warn "$have_file already exists; --license $LICENSE_ID ignored"
    return 0
  fi
  if [ ! -e "$DIR/LICENSE" ]; then
    tpl="$GHLESS_HOME/libexec/licenses/$(printf '%s' "$LICENSE_KEY" | tr 'a-z' 'A-Z').txt"
    year=$(date -u +%Y)
    if [ -f "$tpl" ]; then
      sed "s/{{year}}/$year/; s/{{holder}}/$(printf '%s' "$HOLDER" | sed 's/[\/&]/\\&/g')/" "$tpl" > "$DIR/LICENSE"
    else
      body=$(curl -fsS -m 30 "https://api.github.com/licenses/$LICENSE_KEY" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["body"])' 2>/dev/null) ||
        die "license '$LICENSE_KEY' is not bundled (0BSD, MIT, ISC) and api.github.com/licenses/$LICENSE_KEY did not answer"
      printf '%s\n' "$body" | sed "s/\[year\]/$year/; s/\[fullname\]/$(printf '%s' "$HOLDER" | sed 's/[\/&]/\\&/g')/" > "$DIR/LICENSE"
    fi
  fi
  git -C "$DIR" add LICENSE
  git -C "$DIR" commit -q -m "chore: add LICENSE (${LICENSE_ID:-0BSD})" -- LICENSE ||
    die "could not commit LICENSE in $DIR (is git user.name/user.email set?)"
  LICENSE_NOTE="added LICENSE (${LICENSE_ID:-0BSD}) in $(git -C "$DIR" rev-parse --short HEAD)"
}

make_zip() {
  mkdir -p "$GHLESS_DATA/zips"
  ZIP="$GHLESS_DATA/zips/$NAME-$(git -C "$DIR" rev-parse --short HEAD).zip"
  git -C "$DIR" archive --format=zip --prefix="$NAME/" -o "$ZIP" HEAD &&
    (cd "$(dirname "$ZIP")" && sha256sum "$(basename "$ZIP")" > "$ZIP.sha256") &&
    ledger_add zip "$NAME" "$ZIP" ok
}

mirror_and_archive() { # radicle, nostr, arweave, then the archive job
  step "mirror to radicle, nostr, arweave" "$GHLESS_HOME/libexec/publish" "$DIR" --name "$NAME" --lanes radicle,nostr,arweave ${DESC:+--desc "$DESC"}
  if [ "$NET" = 1 ]; then step "archive job" "$GHLESS_HOME/libexec/archive" "$DIR" --name "$NAME"
  else step "archive (offline part only)" "$GHLESS_HOME/libexec/archive" "$DIR" --name "$NAME" --no-net; fi
}

ZIP=""
case "$GH:$PRIVATE" in
  active:1)
    ensure_license
    step "publish to github (private)" "$GHLESS_HOME/libexec/publish" "$DIR" --name "$NAME" --lanes github --private ${DESC:+--desc "$DESC"} ;;
  active:0)
    ensure_license
    step "publish to github (public)" "$GHLESS_HOME/libexec/publish" "$DIR" --name "$NAME" --lanes github ${DESC:+--desc "$DESC"}
    mirror_and_archive
    step "zip of HEAD" make_zip ;;
  inactive:1)
    step "zip of HEAD" make_zip ;;
  inactive:0)
    ensure_license
    mirror_and_archive
    step "page over a cfrs tunnel" "$GHLESS_HOME/libexec/serve" "$NAME=$DIR"
    step "zip of HEAD" make_zip ;;
esac

NEW=$(tail -n +"$((BEFORE + 1))" "$LEDGER" 2>/dev/null)
row() { # row LANE: "STATUS<TAB>URL" of the newest ledger row of this run, empty when none
  printf '%s\n' "$NEW" | awk -F'\t' -v l="$1" -v n="$NAME" '$2==l && $3==n {s=$5; u=$4} END {if (s != "") printf "%s\t%s", s, u}'
}
show() { # show LABEL LANE
  r=$(row "$2")
  if [ -n "$r" ]; then printf '%-12s %s  %s\n' "$1:" "${r%%	*}" "${r#*	}"; else printf '%-12s not run\n' "$1:"; fi
}
HEADSHA=$(git -C "$DIR" rev-parse HEAD)
BRANCH=$(git -C "$DIR" symbolic-ref -q --short HEAD || echo detached)
echo "----- push summary: $NAME -----"
echo "commit:      $HEADSHA ($BRANCH)"
echo "login:       $GH"
echo "visibility:  $VIS"
[ -z "$LICENSE_NOTE" ] || echo "license:     $LICENSE_NOTE"
echo "plan:        $PLAN"
show_github() {
  show "github" github
  if [ -n "$(row github)" ]; then
    login=$(GH_FORGE_MODE=real gh api user --jq .login 2>/dev/null)
    actual=$(GH_FORGE_MODE=real gh repo view "$login/$NAME" --json visibility --jq .visibility 2>/dev/null | tr 'A-Z' 'a-z')
    echo "github says: ${actual:-unknown} visibility"
  fi
}
show_zip() { show "zip" zip; [ -z "$ZIP" ] || echo "sha256:      $(cut -d' ' -f1 "$ZIP.sha256" 2>/dev/null)"; }
show_mirror() { show "radicle" radicle; show "nostr" nostr; show "arweave" arweave; show "archive" archive; show "swh" swh; show "wayback" wayback; show "snapshot" ghre-snap; }
case "$GH:$PRIVATE" in
  active:1) show_github ;;
  active:0) show_github; show_mirror; show_zip ;;
  inactive:1) show_zip ;;
  inactive:0) show_mirror; show "page" tunnel; show_zip ;;
esac
echo "log:         $LOG"
if [ -n "$FAILED" ]; then echo "result:      FAILED:$FAILED"; exit 1; fi
if [ "$GH:$PRIVATE" != inactive:1 ]; then
  lanes_ok=$(printf '%s\n' "$NEW" | awk -F'\t' '$2 ~ /^(github|radicle|nostr|arweave)$/ && $5 ~ /^ok/ {c++} END {print c+0}')
  [ "$lanes_ok" -gt 0 ] || { echo "result:      FAILED: no host accepted the push (see the rows above)"; exit 1; }
fi
echo "result:      ok"
