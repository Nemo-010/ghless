#!/bin/sh
# fetch: clone any public repo and open a work branch.
#   errand fetch SPEC [DIR] [--ref REF] [--depth N]
# Routes, in order: direct git, git through the broker, source tarball.
# Re-running on an existing checkout fetches instead of cloning again.
set -u
ERRAND_HOME="${ERRAND_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
. "$ERRAND_HOME/libexec/common.sh"
. "$ERRAND_HOME/libexec/spec.sh"

SPEC=""; DIR=""; REF=""; DEPTH=""
while [ $# -gt 0 ]; do
  case "$1" in
    --ref) shift; REF="$1" ;;
    --depth) shift; DEPTH="$1" ;;
    -h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) if [ -z "$SPEC" ]; then SPEC="$1"; elif [ -z "$DIR" ]; then DIR="$1"; else die "too many arguments"; fi ;;
  esac
  shift
done
[ -n "$SPEC" ] || die "usage: errand fetch SPEC [DIR] [--ref REF] [--depth N]"
parse_spec "$SPEC" || die "cannot understand: $SPEC"
[ -n "$REF" ] || REF="$S_REF"
if [ -z "$DIR" ]; then
  if [ "$S_GITHUB" = 1 ]; then DIR="$ERRAND_WORK/${S_OWNER}__${S_REPO}"
  else DIR="$ERRAND_WORK/$(basename "${S_URL%.git}")"; fi
fi
mkdir -p "$(dirname "$DIR")"

depth_args=""; [ -n "$DEPTH" ] && depth_args="--depth $DEPTH"
ref_args=""; [ -n "$REF" ] && ref_args="--branch $REF"

route=""
if [ -d "$DIR/.git" ] && [ "$(git -C "$DIR" config --get errand.source 2>/dev/null)" = "$S_URL" ]; then
  say "$DIR exists; fetching updates"
  git_safe -C "$DIR" fetch --all --tags --prune -q 2>/dev/null ||
    git_safe -C "$DIR" fetch -q "$BROKER/$S_URL" '+refs/heads/*:refs/remotes/origin/*' 2>/dev/null ||
    warn "fetch failed; working with what is already there"
  echo "$DIR"; exit 0
fi
[ -e "$DIR" ] && [ -n "$(ls -A "$DIR" 2>/dev/null)" ] && die "$DIR exists and is not an errand checkout"

try_clone() { # try_clone URL
  rm -rf "$DIR"
  # shellcheck disable=SC2086
  git_safe clone -q $depth_args $ref_args "$1" "$DIR" 2>/dev/null
}

if try_clone "$S_URL"; then route=direct
elif try_clone "$BROKER/$S_URL"; then route=broker
elif [ "$S_GITHUB" = 1 ]; then
  say "git routes failed; trying the source tarball (no history)"
  t=$(mktemp -d "${TMPDIR:-/tmp}/errand-fetch.XXXXXX")
  r="${REF:-HEAD}"
  base="https://codeload.github.com/$S_OWNER/$S_REPO/tar.gz/$r"
  if fetch_to "$base" "$t/src.tgz" && tar -xzf "$t/src.tgz" -C "$t"; then
    top=$(find "$t" -mindepth 1 -maxdepth 1 -type d | head -n1)
    rm -rf "$DIR"; mv "$top" "$DIR"
    git -C "$DIR" init -q
    git -C "$DIR" add -A
    git -C "$DIR" -c user.name=errand -c user.email=errand@localhost \
      commit -q -m "snapshot of $S_OWNER/$S_REPO at $r (tarball, no upstream history)"
    git -C "$DIR" remote add origin "$S_URL"
    route=tarball
  fi
  rm -rf "$t"
fi
[ -n "$route" ] || die "all routes failed for $SPEC. If the account was deleted, try: ghre ledger ${S_OWNER:-ACCOUNT} --out work/${S_OWNER:-ACCOUNT}"

git -C "$DIR" remote set-url origin "$S_URL" 2>/dev/null
base_commit=$(git -C "$DIR" rev-parse HEAD)
git -C "$DIR" tag -f errand/source-base "$base_commit" >/dev/null
git -C "$DIR" config errand.source "$S_URL"
git -C "$DIR" config errand.route "$route"
git -C "$DIR" config errand.base "$base_commit"
git -C "$DIR" config errand.fetched "$(now_utc)"
git -C "$DIR" config user.name >/dev/null 2>&1 || git -C "$DIR" config user.name "errand"
git -C "$DIR" config user.email >/dev/null 2>&1 || git -C "$DIR" config user.email "errand@users.noreply.invalid"
git -C "$DIR" switch -q -c errand/work 2>/dev/null || git -C "$DIR" switch -q errand/work
say "fetched $S_URL via $route at ${base_commit%"${base_commit#???????}"}; branch errand/work"
echo "$DIR"
