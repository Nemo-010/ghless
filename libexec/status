#!/bin/sh
# status: what was published where, from the ledger.
#   ghless status [--check]    --check asks Radicle seeds, the Nostr GRASP server, Arweave and the git web index what they serve now
set -u
GHLESS_HOME="${GHLESS_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
. "$GHLESS_HOME/libexec/common.sh"
CHECK=0; [ "${1:-}" = "--check" ] && CHECK=1
L="$GHLESS_DATA/published.tsv"
[ -s "$L" ] || { echo "nothing published yet (ghless publish DIR)"; exit 0; }
# latest row per lane+project
awk -F'\t' '{k=$2 "\t" $3; row[k]=$0} END {for (k in row) print row[k]}' "$L" | sort -t'	' -k3,3 -k2,2 |
while IFS='	' read -r ts lane proj url st; do
  printf '%-20s %-9s %-8s %s\n' "$ts" "$lane" "$st" "$proj  $url"
  [ "$CHECK" = 1 ] || continue
  case "$lane" in
    radicle)
      rid=$(printf '%s' "$url" | grep -o 'rad:[A-Za-z0-9]*')
      [ -n "$rid" ] || continue
      for h in iris.radicle.xyz radicle.jarg.io seed.radicle.xyz; do
        head=$(curl -s -m 15 "https://$h/api/v1/repos/$rid" | jq -r '.payloads["xyz.radicle.project"].meta.head // "absent"' 2>/dev/null)
        printf '    %-22s head %s\n' "$h" "$head"
      done ;;
    nostr)
      m=$(printf '%s' "$url" | sed -n 's#^nostr://\([^/]*\)/\([^/]*\)/\([^/]*\)$#\1 \2 \3#p')
      [ -n "$m" ] || continue
      set -- $m
      head=$(curl -s -m 20 "https://$2/$1/$3.git/info/refs?service=git-upload-pack" | tr -d '\0' | grep -o '[0-9a-f]\{40\} HEAD' | head -n1 | cut -d' ' -f1)
      printf '    %-22s head %s\n' "$2 (GRASP)" "${head:-absent}" ;;
    arweave)
      for u in $(printf '%s' "$url" | grep -o 'arweave://[A-Za-z0-9_/.-]*'); do
        head=$(timeout 60 git ls-remote "$u" HEAD refs/heads/main 2>/dev/null | head -n1 | cut -c1-40)
        printf '    %-22s head %s\n' "${u##*/}" "${head:-absent or not settled yet}"
      done ;;
    tunnel)
      c=$(curl -s -m 15 -o /dev/null -w '%{http_code}' "$url/index.html"); printf '    index answers %s\n' "$c" ;;
  esac
done
