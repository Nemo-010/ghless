#!/bin/sh
# publish: push a project to every lane that works, record where it went.
#   ghless publish [DIR] [--dry-run] [--name NAME] [--lanes a,b] [--desc TEXT] [--no-verify]
# DIR defaults to the current directory. The pushed ref is DIR's HEAD, published
# as `main` from a staging repo kept in $GHLESS_DATA/publish/NAME, so DIR's own
# remotes and branches are never touched. Re-running updates the same repos; a
# lane that failed last time is retried first. A lane that cannot run is
# reported and skipped; the exit code is 0 when at least one lane succeeded.
# Every pushed lane is verified (default): the host is asked what it serves and
# the ledger records ok:verified, not just ok. --no-verify skips that wait.
set -u
GHLESS_HOME="${GHLESS_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
. "$GHLESS_HOME/libexec/common.sh"

DIR=""; NAME=""; LANES=""; DESC=""; DRY=0; VERIFY=1
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --no-verify) VERIFY=0 ;;
    --name|--lanes|--desc) [ $# -ge 2 ] || die "$1 needs a value"
      case "$1" in --name) NAME="$2" ;; --lanes) LANES="$2" ;; --desc) DESC="$2" ;; esac
      shift ;;
    -h|--help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option: $1 (try --help)" ;;
    *) DIR="$1" ;;
  esac
  shift
done
DIR="$(cd "${DIR:-.}" 2>/dev/null && pwd -P)" || die "no such directory: ${DIR:-.}"
git -C "$DIR" rev-parse --git-dir >/dev/null 2>&1 || die "$DIR is not a git repository"
[ -n "$NAME" ] || NAME=$(basename "$DIR")
valid_name "$NAME" || NAME=$(printf '%s' "$NAME" | sed 's/[^A-Za-z0-9._-]/-/g; s/^[-.]*//')
valid_name "$NAME" || die "no usable name; pass --name (letters, digits, . _ -, not starting with . or -)"
[ -n "$DESC" ] || DESC="$NAME, published by ghless"
if [ -z "$LANES" ]; then
  LANES="radicle,nostr,arweave"
  github_authed && LANES="github,$LANES"
fi

if [ "$DRY" = 1 ]; then
  git -C "$DIR" rev-parse --verify -q HEAD >/dev/null || die "$DIR has no commits to publish"
  say "dry run: would publish $DIR (HEAD $(git -C "$DIR" rev-parse --short HEAD)) as '$NAME' to: $LANES"
  ready=0
  case ",$LANES," in *,github,*) ;; *) echo "github   skipped: no working token (a login adds this lane automatically)" ;; esac
  for l in $(printf '%s' "$LANES" | tr ',' ' '); do
    case "$l" in
      github) if github_authed; then echo "github   ready"; ready=$((ready + 1)); else echo "github   would be skipped: no working token"; fi ;;
      radicle) if have rad; then echo "radicle  ready"; ready=$((ready + 1)); else echo "radicle  rad missing (ghless tools install radicle)"; fi ;;
      nostr) if have ngit; then echo "nostr    ready"; ready=$((ready + 1)); else echo "nostr    ngit missing"; fi ;;
      arweave) if have git-remote-arweave; then echo "arweave  ready"; ready=$((ready + 1)); else echo "arweave  helper missing"; fi ;;
      *) echo "$l  unknown lane" ;;
    esac
  done
  [ "$ready" -gt 0 ]; exit $?
fi
STAGE="$GHLESS_DATA/publish/$NAME"
mkdir -p "$STAGE"
[ -d "$STAGE/.git" ] || git -C "$STAGE" init -q -b main
if [ -f "$STAGE/.git/ghless-source" ]; then
  bound=$(cat "$STAGE/.git/ghless-source")
  if [ "$bound" != "$DIR" ]; then
    if [ ! -e "$bound" ] && git -C "$DIR" rev-parse --verify -q HEAD >/dev/null 2>&1; then
      say "name '$NAME' was bound to $bound, which no longer exists; rebinding to $DIR"
    else
      die "name '$NAME' already publishes $bound; pass --name to publish $DIR separately"
    fi
  fi
fi
[ -n "$(git -C "$DIR" status --porcelain)" ] && warn "$DIR has uncommitted changes; only HEAD is published"
git -C "$STAGE" config user.name >/dev/null 2>&1 || git -C "$STAGE" config user.name ghless
git -C "$STAGE" config user.email >/dev/null 2>&1 || git -C "$STAGE" config user.email ghless@users.noreply.invalid
git_safe -C "$STAGE" fetch -q "$DIR" '+HEAD:refs/heads/incoming' || die "cannot read HEAD of $DIR"
git -C "$STAGE" checkout -q -f -B main incoming
printf '%s' "$DIR" > "$STAGE/.git/ghless-source"
git -C "$DIR" config ghless.name "$NAME" 2>/dev/null || true
HEADSHA=$(git -C "$STAGE" rev-parse --short HEAD)
want_head=$(git -C "$STAGE" rev-parse HEAD)
say "staging $NAME at $HEADSHA (lanes: $LANES)"

ok=0
result() { # result LANE URL STATUS
  ledger_add "$1" "$NAME" "$2" "$3"
  printf '%-9s %-6s %s\n' "$1" "$3" "$2"
  case "$3" in ok*) ok=$((ok + 1)) ;; esac
}

# verify_wait LANE CHECK...: poll CHECK (a function printing the served HEAD,
# empty when absent) until it equals the pushed commit or the deadline passes.
VERIFY_SECS="${GHLESS_VERIFY_SECS:-240}"
verify_wait() { # verify_wait DEADLINE SECS CMD... (CMD prints the served head)
  [ "$VERIFY" = 1 ] || return 0
  _want="$1"; _secs="$2"; shift 2
  _waited=0
  while [ "$_waited" -lt "$_secs" ]; do
    [ "$(_cmd_head "$@")" = "$_want" ] && return 0
    sleep 15; _waited=$((_waited + 15))
  done
  return 1
}
_cmd_head() { "$@" 2>/dev/null; }

GHLESS_GITHUB_URL="${GHLESS_GITHUB_URL:-https://github.com}"
github_head() { # print the HEAD github serves for the repo, empty when absent
  GH_FORGE_MODE=real gh api "repos/$1/commits/main" --jq .sha 2>/dev/null
}

lane_github() {
  github_authed || { result github "-" "skipped: no working GitHub token"; return; }
  login=$(GH_FORGE_MODE=real gh api user --jq .login 2>/dev/null)
  if ! GH_FORGE_MODE=real gh repo view "$login/$NAME" >/dev/null 2>&1; then
    GH_FORGE_MODE=real gh repo create "$login/$NAME" --public --description "$DESC" >/dev/null 2>&1 ||
      { result github "$login/$NAME" "failed: repo create"; return; }
  fi
  git -C "$STAGE" remote get-url github >/dev/null 2>&1 || git -C "$STAGE" remote add github "$GHLESS_GITHUB_URL/$login/$NAME.git"
  out=$(git_safe -C "$STAGE" -c credential.helper= -c 'credential.helper=!GH_FORGE_MODE=real gh auth git-credential' push github main 2>&1)
  if [ $? -ne 0 ]; then
    result github "$GHLESS_GITHUB_URL/$login/$NAME" "failed: $(printf '%s' "$out" | tail -n1)"
    return
  fi
  if verify_wait "$want_head" "$VERIFY_SECS" github_head "$login/$NAME"; then
    result github "$GHLESS_GITHUB_URL/$login/$NAME" "ok:verified"
  else
    result github "$GHLESS_GITHUB_URL/$login/$NAME" ok
  fi
}

lane_radicle() {
  have rad || { result radicle "-" "failed: rad not installed (ghless tools install radicle)"; return; }
  export RAD_HOME="$GHLESS_DATA/radicle" RAD_PASSPHRASE=""
  mkdir -p "$RAD_HOME"
  [ -f "$RAD_HOME/keys/radicle" ] || rad auth --alias ghless >/dev/null 2>&1 ||
    { result radicle "-" "failed: rad auth"; return; }
  seeds=""; seedhosts=""; n=0
  for host in iris.radicle.xyz radicle.jarg.io seed.radicle.xyz; do
    info=$(curl -fsS -m 20 "https://$host/api/v1/node" 2>/dev/null) || continue
    nid=$(printf '%s' "$info" | jq -r .id 2>/dev/null)
    addr=$(printf '%s' "$info" | jq -r '[.config.externalAddresses[]? | select(test("\\.(onion|i2p):") | not)][0] // empty' 2>/dev/null)
    [ -n "$nid" ] && [ -n "$addr" ] || continue
    h="${addr%:*}"; p="${addr##*:}"
    if direct_tcp "$h" "$p"; then
      seeds="$seeds $nid@$addr"; seedhosts="$seedhosts $host"
    elif warp_up; then
      n=$((n + 1)); lp=$(free_port)
      cfrs warp forward --detach --replace --name "ghless-rad-$n" --local "127.0.0.1:$lp=$h:$p" >/dev/null 2>&1 &&
        { seeds="$seeds $nid@127.0.0.1:$lp"; seedhosts="$seedhosts $host"; }
    fi
  done
  [ -n "$seeds" ] || { result radicle "-" "failed: no seed reachable"; return; }
  arr=$(printf '%s\n' $seeds | jq -R . | jq -s .)
  rad node stop >/dev/null 2>&1
  [ -f "$RAD_HOME/config.json" ] || printf '{}\n' > "$RAD_HOME/config.json"
  tmp="$RAD_HOME/config.json.tmp"
  jq --argjson s "$arr" '.preferredSeeds = $s | .node.connect = $s | .node.peers = {"type":"static"}' \
    "$RAD_HOME/config.json" > "$tmp" && mv "$tmp" "$RAD_HOME/config.json"
  detach_run "$RAD_HOME/node.stderr.log" rad node start --foreground
  i=0; while [ $i -lt 20 ] && ! rad node status >/dev/null 2>&1; do sleep 1; i=$((i + 1)); done
  (
    cd "$STAGE" || exit 1
    if ! rad inspect --rid >/dev/null 2>&1; then
      rad init --name "$NAME" --description "$DESC" --default-branch main --public --no-confirm >/dev/null 2>&1 || exit 2
    fi
    git push -q rad main --force >/dev/null 2>&1 || exit 3
    timeout 30 rad sync --announce >/dev/null 2>&1
    exit 0
  )
  case $? in
    0) ;;
    2) result radicle "-" "failed: rad init"; return ;;
    *) result radicle "-" "failed: push"; return ;;
  esac
  rid=$(cd "$STAGE" && rad inspect --rid 2>/dev/null)
  have_copy=""; waited=0
  while [ $waited -lt 180 ]; do
    have_copy=""
    for host in $seedhosts; do
      seen=$(curl -s -m 15 "https://$host/api/v1/repos/$rid" | jq -r '.payloads["xyz.radicle.project"].meta.head // empty' 2>/dev/null)
      [ "$seen" = "$want_head" ] && have_copy="$have_copy $host"
    done
    [ -n "$have_copy" ] && break
    sleep 10; waited=$((waited + 10))
    # seeds fetch on announcement; a dropped or timed-out peer misses it, so repeat it
    [ $((waited % 60)) -eq 0 ] && (cd "$STAGE" && RAD_HOME="$RAD_HOME" timeout 30 rad sync --announce >/dev/null 2>&1)
  done
  if [ -n "$have_copy" ]; then result radicle "$rid (copy on:$have_copy)" "ok:verified"
  else result radicle "$rid" "failed: no seed serves the pushed commit after 180s (node log: $RAD_HOME/node.stderr.log)"; fi
}

grasp_head() { # grasp_head RELAY NPUB IDENT: print the HEAD the GRASP server serves, empty when absent
  curl -s -m 20 "https://$1/$2/$3.git/info/refs?service=git-upload-pack" | tr -d '\0' \
    | grep -o '[0-9a-f]\{40\} HEAD' | head -n1 | cut -d' ' -f1
}

lane_nostr() {
  have ngit || { result nostr "-" "failed: ngit not installed (ghless tools install ngit)"; return; }
  key="$GHLESS_DATA/nostr.key"
  if [ ! -s "$key" ]; then
    ( umask 077; nostr_keygen > "$key" ) || { result nostr "-" "failed: key generation"; return; }
  fi
  ident=$(printf '%s' "$NAME" | tr 'A-Z' 'a-z')
  (
    cd "$STAGE" || exit 1
    export XDG_DATA_HOME="$GHLESS_DATA/xdg"
    mkdir -p "$XDG_DATA_HOME"
    if ! git remote get-url origin 2>/dev/null | grep -q '^nostr://'; then
      net_run ngit --nsec-file "$key" init --name "$NAME" --identifier "$ident" --description "$DESC" --defaults >/dev/null 2>&1 || exit 2
    else
      ngit account login --local --nsec-file "$key" --secret-storage file --offline >/dev/null 2>&1
      net_run git push origin main >/dev/null 2>&1 || exit 3
    fi
  )
  rc=$?
  url=$(git -C "$STAGE" remote get-url origin 2>/dev/null)
  case $rc in
    0) ;;
    2) result nostr "-" "failed: ngit init"; return ;;
    *) result nostr "${url:--}" "failed: push"; return ;;
  esac
  m=$(printf '%s' "$url" | sed -n 's#^nostr://\([^/]*\)/\([^/]*\)/\([^/]*\)$#\2 \1 \3#p')
  if [ -n "$m" ] && verify_wait "$want_head" "$VERIFY_SECS" grasp_head $m; then
    result nostr "$url" "ok:verified"
  else
    result nostr "$url" ok
  fi
}

arweave_verify() { # arweave_verify MANIFEST_TX PACK_TX: 0 when both transactions are live on the gateway
  [ "$VERIFY" = 1 ] || return 0
  [ -n "$1" ] && [ -n "$2" ] || return 1
  for _tx in "$1" "$2"; do
    c=$(curl -s -o /dev/null -w '%{http_code}' -L -m 60 "https://arweave.net/$_tx")
    [ "$c" = 200 ] || return 1
  done
}

lane_arweave() {
  have git-remote-arweave || { result arweave "-" "failed: git-remote-arweave not installed (ghless tools install arweave)"; return; }
  wallet="$GHLESS_DATA/arweave-wallet.json"
  if [ ! -s "$wallet" ]; then
    "$GHLESS_HOME/libexec/arweave-wallet.py" "$wallet" >/dev/null || { result arweave "-" "failed: wallet generation"; return; }
  fi
  addr=$("$GHLESS_HOME/libexec/arweave-wallet.py" --address "$wallet" 2>/dev/null)
  [ -n "$addr" ] || { result arweave "-" "failed: wallet address unknown"; return; }
  url="arweave://$addr/$NAME"
  git -C "$STAGE" remote get-url arweave >/dev/null 2>&1 && git -C "$STAGE" remote set-url arweave "$url" || git -C "$STAGE" remote add arweave "$url"
  out=$(ARWEAVE_WALLET="$wallet" git -C "$STAGE" push arweave main 2>&1)
  if [ $? -eq 0 ]; then
    rdir="$STAGE/.git/arweave/remotes/$addr/$NAME"
    mtx=$(cat "$rdir/genesis-manifest" 2>/dev/null)
    ptx=$(jq -r '.pack_tx // empty' "$rdir/pending.json" 2>/dev/null)
    if arweave_verify "$mtx" "$ptx"; then result arweave "$url (tx:$mtx)" "ok:verified"
    else result arweave "$url (tx:$mtx)" ok; fi
    return
  fi
  case "$out" in
    *"returned 402"*) ;;
    *) result arweave "$url" "failed: $(printf '%s' "$out" | tail -n1 | cut -c1-200)"; return ;;
  esac
  say "arweave: pack is over the free tier (402); publishing as parts under 100 KiB each"
  parts="$GHLESS_DATA/arweave-parts/$NAME"
  mkdir -p "$parts"
  names=$("$GHLESS_HOME/libexec/arweave-split.py" "$STAGE" "$parts" "$NAME" "$addr") ||
    { result arweave "$url" "failed: cannot split under the free tier"; return; }
  urls=""; bad=0; verified=0
  for pn in $names; do
    purl="arweave://$addr/$pn"
    git -C "$parts/$pn" remote get-url arweave >/dev/null 2>&1 && git -C "$parts/$pn" remote set-url arweave "$purl" || git -C "$parts/$pn" remote add arweave "$purl"
    pout=$(ARWEAVE_WALLET="$wallet" git -C "$parts/$pn" push arweave main 2>&1) || { bad=$((bad + 1)); warn "arweave part $pn: $(printf '%s' "$pout" | tail -n1 | cut -c1-160)"; continue; }
    prdir="$parts/$pn/.git/arweave/remotes/$addr/$pn"
    pmtx=$(cat "$prdir/genesis-manifest" 2>/dev/null)
    pptx=$(jq -r '.pack_tx // empty' "$prdir/pending.json" 2>/dev/null)
    [ -n "$pmtx" ] && arweave_verify "$pmtx" "$pptx" && verified=$((verified + 1))
    urls="$urls arweave://$addr/$pn(tx:$pmtx)"
  done
  if [ $bad -eq 0 ]; then
    if [ "$verified" = "$(printf '%s' "$names" | wc -w)" ] && [ "$VERIFY" = 1 ]; then result arweave "parts:$urls" "ok:verified"
    else result arweave "parts:$urls" ok; fi
  else result arweave "parts:$urls" "failed: $bad part(s) rejected"; fi
}

failed=""
for lane in $(printf '%s' "$LANES" | tr ',' ' '); do
  case "$lane" in radicle) say "lane radicle: starting (waits up to 3 minutes for a seed to serve the commit)" ;; *) say "lane $lane: starting" ;; esac
  case "$lane" in
    github) lane_github ;; radicle) lane_radicle ;; nostr) lane_nostr ;; arweave) lane_arweave ;;
    *) warn "unknown lane: $lane" ;;
  esac
  last=$(awk -F'\t' -v l="$lane" -v n="$NAME" '$2==l && $3==n {s=$5} END {print s}' "$GHLESS_DATA/published.tsv" 2>/dev/null)
  case "$last" in failed*) failed="$failed $lane" ;; esac
done
if [ -n "$failed" ]; then
  warn "lane(s)$failed failed; a host may be blocking them. The copy you have is still safe; re-running this command retries those lanes. Check 'ghless status --check' for what every host serves now."
fi
[ "$ok" -gt 0 ]
