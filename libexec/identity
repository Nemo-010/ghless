#!/bin/sh
# identity: mint or show the self-made identities used by `publish`.
#   ghless identity [show]    print public identifiers only, never keys
#   ghless identity init      create any identity that does not exist yet
#   ghless identity export F  back up all private keys to F (0600, refuses to overwrite)
#   ghless identity import F  restore keys that are missing
# Keys live in $GHLESS_DATA (radicle/, nostr.key, arweave-wallet.json), mode 0600.
# Back that directory up; losing it loses the right to update what was published.
set -u
GHLESS_HOME="${GHLESS_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
. "$GHLESS_HOME/libexec/common.sh"
mkdir -p "$GHLESS_DATA"; chmod 700 "$GHLESS_DATA" 2>/dev/null

init() {
  export RAD_HOME="$GHLESS_DATA/radicle" RAD_PASSPHRASE=""
  if have rad && [ ! -f "$RAD_HOME/keys/radicle" ]; then rad auth --alias ghless >/dev/null 2>&1 && say "radicle identity created"; fi
  if [ ! -s "$GHLESS_DATA/nostr.key" ]; then ( umask 077; nostr_keygen > "$GHLESS_DATA/nostr.key" ) && say "nostr key created"; fi
  if have openssl && [ ! -s "$GHLESS_DATA/arweave-wallet.json" ]; then
    "$GHLESS_HOME/libexec/arweave-wallet.py" "$GHLESS_DATA/arweave-wallet.json" >/dev/null && say "arweave wallet created"
  fi
}

show() {
  export RAD_HOME="$GHLESS_DATA/radicle" RAD_PASSPHRASE=""
  if have rad && [ -f "$RAD_HOME/keys/radicle" ]; then printf 'radicle  %s\n' "$(rad self --did 2>/dev/null)"; else echo "radicle  none"; fi
  if [ -s "$GHLESS_DATA/nostr.key" ]; then
    printf 'nostr    %s\n' "$(nostr_npub "$GHLESS_DATA/nostr.key")"
  else echo "nostr    none"; fi
  if [ -s "$GHLESS_DATA/arweave-wallet.json" ]; then printf 'arweave  %s\n' "$("$GHLESS_HOME/libexec/arweave-wallet.py" --address "$GHLESS_DATA/arweave-wallet.json")"; else echo "arweave  none"; fi
  if github_authed; then printf 'github   %s\n' "$(GH_FORGE_MODE=real gh api user --jq .login 2>/dev/null)"; else echo "github   none"; fi
}

export_ids() { # export_ids FILE: tar of every private key, mode 0600
  [ -n "${1:-}" ] || die "usage: identity export FILE"
  out=$(abspath "$1")
  [ ! -e "$out" ] || die "$out exists; refusing to overwrite"
  items=""; for f in radicle nostr.key arweave-wallet.json; do [ -e "$GHLESS_DATA/$f" ] && items="$items $f"; done
  [ -n "$items" ] || die "no identities to export (run: ghless identity init)"
  # shellcheck disable=SC2086
  ( umask 077; cd "$GHLESS_DATA" && tar -czf "$out" $items ) || die "export failed"
  say "wrote $1 (mode 0600). It holds private keys: store it somewhere safe, never commit it."
}
import_ids() { # import_ids FILE: restores keys that do not exist yet
  [ -f "${1:-}" ] || die "usage: identity import FILE"
  t=$(mktemp -d "${TMPDIR:-/tmp}/ghless-id.XXXXXX")
  trap 'rm -rf "$t"' EXIT
  tar -xzf "$1" -C "$t" || die "not a ghless identity archive"
  if [ -n "$(find "$t" ! -type f ! -type d -print -quit)" ]; then
    die "archive holds links or special files; refusing to import it"
  fi
  for f in radicle nostr.key arweave-wallet.json; do
    [ -e "$t/$f" ] || continue
    if [ -e "$GHLESS_DATA/$f" ]; then warn "$f already exists; kept"; else cp -R "$t/$f" "$GHLESS_DATA/$f" && say "restored $f"; fi
  done
  chmod 600 "$GHLESS_DATA/nostr.key" "$GHLESS_DATA/arweave-wallet.json" 2>/dev/null
  if [ -s "$GHLESS_DATA/nostr.key" ] && ! grep -qE '^[0-9a-f]{64}$' "$GHLESS_DATA/nostr.key"; then
    warn "nostr.key is not 64 lowercase hex characters; it was restored but will not work"
  fi
  show
}

case "${1:-show}" in
  export) export_ids "${2:-}" ;;
  import) import_ids "${2:-}" ;;
  init) init; show ;;
  show) show ;;
  *) die "usage: identity [show|init|export FILE|import FILE]" ;;
esac
