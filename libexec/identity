#!/bin/sh
# identity: mint or show the self-made identities used by `publish`.
#   errand identity [show]    print public identifiers only, never keys
#   errand identity init      create any identity that does not exist yet
# Keys live in $ERRAND_DATA (radicle/, nostr.key, arweave-wallet.json), mode 0600.
# Back that directory up; losing it loses the right to update what was published.
set -u
ERRAND_HOME="${ERRAND_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
. "$ERRAND_HOME/libexec/common.sh"
mkdir -p "$ERRAND_DATA"; chmod 700 "$ERRAND_DATA" 2>/dev/null

init() {
  export RAD_HOME="$ERRAND_DATA/radicle" RAD_PASSPHRASE=""
  if have rad && [ ! -f "$RAD_HOME/keys/radicle" ]; then rad auth --alias errand >/dev/null 2>&1 && say "radicle identity created"; fi
  if have nak && [ ! -s "$ERRAND_DATA/nostr.key" ]; then ( umask 077; nak key generate > "$ERRAND_DATA/nostr.key" ) && say "nostr key created"; fi
  if have openssl && [ ! -s "$ERRAND_DATA/arweave-wallet.json" ]; then
    a=$("$ERRAND_HOME/libexec/arweave-wallet.py" "$ERRAND_DATA/arweave-wallet.json") &&
      printf '%s' "$a" > "$ERRAND_DATA/arweave-address.txt" && say "arweave wallet created"
  fi
}

show() {
  export RAD_HOME="$ERRAND_DATA/radicle" RAD_PASSPHRASE=""
  if have rad && [ -f "$RAD_HOME/keys/radicle" ]; then printf 'radicle  %s\n' "$(rad self --did 2>/dev/null)"; else echo "radicle  none"; fi
  if [ -s "$ERRAND_DATA/nostr.key" ] && have nak; then
    printf 'nostr    %s\n' "$(nak key public < "$ERRAND_DATA/nostr.key" | nak encode npub 2>/dev/null)"
  else echo "nostr    none"; fi
  if [ -s "$ERRAND_DATA/arweave-address.txt" ]; then printf 'arweave  %s\n' "$(cat "$ERRAND_DATA/arweave-address.txt")"; else echo "arweave  none"; fi
  if github_authed; then printf 'github   %s\n' "$(GH_FORGE_MODE=real gh api user --jq .login 2>/dev/null)"; else echo "github   none"; fi
}

case "${1:-show}" in
  init) init; show ;;
  show) show ;;
  *) die "usage: identity [show|init]" ;;
esac
