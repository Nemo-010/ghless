#!/bin/sh
# read: print one file, or the README, of a public repo without cloning.
#   ghless read SPEC [PATH] [REF]
# Routes: raw.githubusercontent.com, the same through the broker, the forge API.
set -u
GHLESS_HOME="${GHLESS_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
. "$GHLESS_HOME/libexec/common.sh"
. "$GHLESS_HOME/libexec/spec.sh"

[ $# -ge 1 ] || die "usage: ghless read SPEC [PATH] [REF]"
parse_spec "$1" || die "cannot understand: $1"
[ "$S_GITHUB" = 1 ] || die "read supports github.com specs; use ghless fetch for other hosts"
[ -z "$S_EXTRA" ] || die "unsupported GitHub URL path '$S_EXTRA'; read supports owner/repo, tree/ and blob/ URLs (releases and issues: use gh)"
P="${2:-$S_PATH}"; REF="${3:-$S_REF}"
FORGE=https://forge.web.pkgforge.dev/github

if [ -z "$P" ]; then
  # raw.githubusercontent.com accepts HEAD as a ref, so no API call (and none of
  # its 60 an hour) is spent when the README has a common name.
  for name in README.md README.markdown README.rst README README.txt readme.md; do
    raw="https://raw.githubusercontent.com/$S_OWNER/$S_REPO/${REF:-HEAD}/$name"
    curl -fsSL -m 30 "$raw" 2>/dev/null && exit 0
  done
  u="$FORGE/repos/$S_OWNER/$S_REPO/readme"
  [ -n "$REF" ] && u="$u?ref=$REF"
  curl -fsSL -m 60 -H 'Accept: application/vnd.github.raw' "$u" && exit 0
  curl -fsSL -m 60 -H 'Accept: application/vnd.github.raw' "https://api.github.com/repos/$S_OWNER/$S_REPO/readme${REF:+?ref=$REF}" && exit 0
  die "cannot read README of $S_OWNER/$S_REPO"
fi

REF="${REF:-HEAD}"
raw="https://raw.githubusercontent.com/$S_OWNER/$S_REPO/$REF/$P"
curl -fsSL -m 60 "$raw" 2>/dev/null && exit 0
curl -fsSL -m 60 "$BROKER/$raw" 2>/dev/null && exit 0
curl -fsSL -m 60 -H 'Accept: application/vnd.github.raw' "$FORGE/repos/$S_OWNER/$S_REPO/contents/$P?ref=$REF" 2>/dev/null && exit 0
die "cannot read $S_OWNER/$S_REPO:$P@$REF by any route"
