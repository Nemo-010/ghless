#!/bin/sh
# completion: print a shell completion script.
#   ghless completion bash|zsh      e.g.  eval "$(ghless completion bash)"
case "${1:-}" in
  bash) cat <<'B'
_ghless() {
  local cur=${COMP_WORDS[COMP_CWORD]} cmds="doctor read fetch work publish push archive serve pack status identity tools update-check completion help version"
  if [ "$COMP_CWORD" -eq 1 ]; then COMPREPLY=($(compgen -W "$cmds" -- "$cur")); return; fi
  case "${COMP_WORDS[1]}" in
    publish) COMPREPLY=($(compgen -W "--name --lanes --desc --dry-run --no-verify github radicle nostr arweave" -- "$cur")) ;;
    push) COMPREPLY=($(compgen -W "--name --private --license --holder --desc --no-net --dry-run" -- "$cur")) ;;
    archive) COMPREPLY=($(compgen -W "--name --out --no-net --deep --public-url --extra" -- "$cur")) ;;
    fetch|work) COMPREPLY=($(compgen -W "--ref --depth" -- "$cur")) ;;
    identity) COMPREPLY=($(compgen -W "show init export import" -- "$cur")) ;;
    tools) COMPREPLY=($(compgen -W "install status cfrs radicle nak ngit arweave" -- "$cur")) ;;
    status) COMPREPLY=($(compgen -W "--check --json" -- "$cur")) ;;
    serve) COMPREPLY=($(compgen -W "--json --status --stop" -- "$cur")) ;;
    completion) COMPREPLY=($(compgen -W "bash zsh" -- "$cur")) ;;
    *) COMPREPLY=($(compgen -f -- "$cur")) ;;
  esac
}
complete -F _ghless ghless
B
  ;;
  zsh) cat <<'Z'
#compdef ghless
_ghless() {
  local -a cmds
  cmds=(doctor read fetch work publish push archive serve pack status identity tools update-check completion help version)
  if (( CURRENT == 2 )); then _describe 'command' cmds; return; fi
  case $words[2] in
    publish) _values 'option' --name --lanes --desc --dry-run --no-verify github radicle nostr arweave ;;
    archive) _values 'option' --name --out --no-net --deep --public-url --extra ;;
    fetch|work) _values 'option' --ref --depth ;;
    identity) _values 'action' show init export import ;;
    tools) _values 'tool' install status cfrs radicle nak ngit arweave ;;
    status) _values 'option' --check --json ;;
    serve) _values 'option' --json --status --stop ;;
    completion) _values 'shell' bash zsh ;;
    *) _files ;;
  esac
}
_ghless "$@"
Z
  ;;
  *) echo "usage: ghless completion bash|zsh" >&2; exit 2 ;;
esac
