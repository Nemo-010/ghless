#!/bin/sh
# install: one-time, idempotent setup of ghless.
#
#   ./install [--core] [--no-tools] [--no-gh-shim] [--no-skill] [--no-path] [--uninstall]
#             [--prefix DIR] [--bin DIR]
#
#   --core         system packages + cfrs only (skip radicle, nak, ngit, arweave)
#   --no-tools     system packages and links only; download no binaries
#   --no-gh-shim   do not put the gh-forge wrapper on PATH as `gh`
#   --no-skill     do not register SKILL.md with agent skill directories
#   --no-path      do not edit shell profiles
#   --uninstall    remove links, profile block and skill links (keeps data)
#
# Environment: GHLESS_PREFIX (binaries, default ~/.local/share/ghless),
# GHLESS_BIN (links, default ~/.local/bin), GHLESS_DATA (state and work).
# Safe to re-run: every step checks before it acts.
set -u
GHLESS_HOME=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
export GHLESS_HOME
USER_DATA="${GHLESS_DATA:-}"; USER_WORK="${GHLESS_WORK:-}"
. "$GHLESS_HOME/libexec/common.sh"

CORE=0; GHSHIM=1; SKILL=1; EDITPATH=1; UNINSTALL=0; NOTOOLS=0; WARNED=0
while [ $# -gt 0 ]; do
  case "$1" in
    --prefix|--bin) [ $# -ge 2 ] || die "$1 needs a value" ;;
  esac
  case "$1" in
    --core) CORE=1 ;;
    --no-gh-shim) GHSHIM=0 ;;
    --no-skill) SKILL=0 ;;
    --no-path) EDITPATH=0 ;;
    --no-tools) NOTOOLS=1 ;;
    --uninstall) UNINSTALL=1 ;;
    --prefix) shift; GHLESS_PREFIX="$(abspath "$1")"; GHLESS_DATA="${USER_DATA:-$GHLESS_PREFIX/data}"; GHLESS_WORK="${USER_WORK:-$GHLESS_DATA/work}"; PATH="$GHLESS_PREFIX/bin:$PATH"; export GHLESS_PREFIX GHLESS_DATA GHLESS_WORK PATH ;;
    --bin) shift; GHLESS_BIN="$(abspath "$1")"; export GHLESS_BIN ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option: $1 (try --help)" ;;
  esac
  shift
done

MARK_BEGIN="# >>> ghless >>>"
MARK_END="# <<< ghless <<<"
SKILL_DIRS="$HOME/.claude/skills $HOME/.agents/skills"
LINKS="ghless ghre ghre-hunt ghre-pack-patches ghre-export-records bulk-archive spn2 arquivo-apn megalodon ghostarchive archive-today urlscan socks-relay"

link_target() {
  case "$1" in
    ghless) echo "$GHLESS_HOME/bin/ghless" ;;
    ghre) echo "$GHLESS_HOME/components/ghre/bin/ghre" ;;
    ghre-hunt) echo "$GHLESS_HOME/components/ghre/bin/hunt" ;;
    ghre-pack-patches) echo "$GHLESS_HOME/components/ghre/bin/pack-patches" ;;
    ghre-export-records) echo "$GHLESS_HOME/components/ghre/bin/export-records" ;;
    bulk-archive) echo "$GHLESS_HOME/components/bulk-archive/bin/bulk-archive.sh" ;;
    spn2) echo "$GHLESS_HOME/components/bulk-archive/bin/spn2.sh" ;;
    arquivo-apn) echo "$GHLESS_HOME/components/bulk-archive/bin/arquivo-apn.sh" ;;
    megalodon) echo "$GHLESS_HOME/components/bulk-archive/bin/megalodon.sh" ;;
    ghostarchive) echo "$GHLESS_HOME/components/bulk-archive/bin/ghostarchive.sh" ;;
    archive-today) echo "$GHLESS_HOME/components/bulk-archive/bin/archive-today.sh" ;;
    urlscan) echo "$GHLESS_HOME/components/bulk-archive/bin/urlscan.sh" ;;
    socks-relay) echo "$GHLESS_HOME/reference/anonymous-git-hosting/scripts/socks-relay.py" ;;
    gh) echo "$GHLESS_HOME/components/gh-forge/bin/gh" ;;
  esac
}

profile_files() {
  for f in "$HOME/.profile" "$HOME/.bashrc" "$HOME/.zshrc"; do
    case "$f" in
      "$HOME/.profile"|"$HOME/.bashrc") echo "$f" ;;
      *) [ -f "$f" ] && echo "$f" ;;
    esac
  done
}

strip_block() { # strip_block FILE: removes only a well-formed block (BEGIN, then END, no BEGIN between)
  [ -f "$1" ] || return 0
  grep -qxF "$MARK_BEGIN" "$1" || return 0
  tmp="$1.ghless.$$"
  awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
    $0==b { if (open) printf "%s", buf; open=1; buf=$0 "\n"; next }
    $0==e && open { open=0; buf=""; next }
    open { buf = buf $0 "\n"; next }
    { print }
    END { if (open) { printf "%s", buf; exit 3 } }
  ' "$1" > "$tmp"
  rc_awk=$?
  if [ $rc_awk -eq 3 ]; then
    rm -f "$tmp"
    warn "$1 has a begin marker with no end marker; left untouched"
    return 1
  fi
  cat "$tmp" > "$1"; rm -f "$tmp"
}

if [ "$UNINSTALL" = 1 ]; then
  for n in $LINKS gh; do
    t=$(link_target "$n"); cur=$(readlink "$GHLESS_BIN/$n" 2>/dev/null) || continue
    # ours: the current checkout, or any other checkout (moved or deleted) with the same inner path
    case "$cur" in "$t"|*"${t#"$GHLESS_HOME"}") rm -f "$GHLESS_BIN/$n" && say "removed $GHLESS_BIN/$n" ;; esac
  done
  for b in cfrs pod-netns rad radicle-node git-remote-rad nak ngit git-remote-nostr git-remote-arweave arweave-git; do
    cur=$(readlink "$GHLESS_BIN/$b" 2>/dev/null) || continue
    case "$cur" in "$GHLESS_PREFIX/bin/$b"|*/ghless/bin/$b) rm -f "$GHLESS_BIN/$b" && say "removed $GHLESS_BIN/$b" ;; esac
  done
  for f in $(profile_files); do strip_block "$f"; done
  rm -f "$GHLESS_PREFIX/env.sh"
  for d in $SKILL_DIRS; do
    [ -L "$d/ghless" ] && rm -f "$d/ghless" && say "removed $d/ghless"
  done
  say "uninstalled; data kept in $GHLESS_DATA, binaries kept in $GHLESS_PREFIX/bin"
  exit 0
fi

say "prefix: $GHLESS_PREFIX  data: $GHLESS_DATA  links: $GHLESS_BIN"
case "$GHLESS_PREFIX" in
  "$HOME"/*) ;;
  *) warn "the prefix is outside \$HOME (XDG_DATA_HOME or GHLESS_PREFIX is set): installs and keys are shared with every user of that path. For an isolated trial: GHLESS_PREFIX=\$HOME/ghless-prefix ./install" ;;
esac
# 1. System packages. The package manager is detected, never assumed.
need=""
for pair in git:git curl:curl python3:python3 jq:jq unzip:unzip zip:zip tar:tar gzip:gzip xz:xz-utils sha256sum:coreutils; do
  have "${pair%%:*}" || need="$need ${pair#*:}"
done
have ssh || need="$need openssh-client"
have openssl || need="$need openssl"
if [ "$CORE" = 0 ]; then have go || need="$need golang-go"; fi
if [ -n "$need" ]; then
  SUDO=""; [ "$(id -u)" != 0 ] && have sudo && SUDO="sudo -n"
  if have apt-get; then
    say "installing system packages:$need"
    $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates $need >/dev/null 2>&1 ||
      { $SUDO env DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1 &&
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates $need >/dev/null; } ||
      warn "apt-get could not install:$need"
  elif have apk; then
    $SUDO apk add --no-cache git curl python3 jq unzip zip tar gzip xz openssl openssh-client go ca-certificates >/dev/null || warn "apk failed"
  elif have dnf; then
    $SUDO dnf install -y git curl python3 jq unzip zip tar gzip xz openssl openssh-clients golang ca-certificates >/dev/null || warn "dnf failed"
  elif have pacman; then
    $SUDO pacman -S --noconfirm --needed git curl python jq unzip zip tar gzip xz openssl openssh go >/dev/null || warn "pacman failed"
  else
    warn "no known package manager; install manually:$need"
  fi
fi
for must in git curl python3; do
  have "$must" || die "$must is required and could not be installed"
done

# 2. Pinned binaries. A tree unpacked without mode bits is repaired first.
chmod +x "$GHLESS_HOME/install" "$GHLESS_HOME/bin/ghless" "$GHLESS_HOME"/libexec/* \
  "$GHLESS_HOME"/components/ghre/bin/* "$GHLESS_HOME"/components/bulk-archive/bin/* \
  "$GHLESS_HOME/components/gh-forge/bin/gh" "$GHLESS_HOME/reference/anonymous-git-hosting/scripts/socks-relay.py" 2>/dev/null
mkdir -p "$GHLESS_PREFIX/bin" "$GHLESS_DATA" "$GHLESS_WORK" "$GHLESS_BIN"
chmod 700 "$GHLESS_DATA" 2>/dev/null
rc=0
if [ "$NOTOOLS" = 1 ]; then
  :
elif [ "$CORE" = 1 ]; then
  "$GHLESS_HOME/libexec/tools" install cfrs || rc=1
else
  "$GHLESS_HOME/libexec/tools" install || rc=1
fi

# 2b. Migration from the first name of this project (errand-home). Only links that
# point into an errand-home tree or the old prefix are removed.
OLD_BEGIN="# >>> errand-home >>>"; OLD_END="# <<< errand-home <<<"
OLD_PREFIX="${XDG_DATA_HOME:-$HOME/.local/share}/errand"
for n in errand $LINKS gh cfrs pod-netns rad radicle-node git-remote-rad nak ngit git-remote-nostr git-remote-arweave arweave-git; do
  tgt=$(readlink "$GHLESS_BIN/$n" 2>/dev/null) || continue
  case "$tgt" in
    */errand-home/*|"$OLD_PREFIX"/*) rm -f "$GHLESS_BIN/$n"; say "migrated: removed old link $GHLESS_BIN/$n" ;;
  esac
done
for f in $(profile_files); do
  if grep -qxF "$OLD_BEGIN" "$f" 2>/dev/null && grep -qxF "$OLD_END" "$f"; then
    MARK_BEGIN_SAVE="$MARK_BEGIN"; MARK_END_SAVE="$MARK_END"
    MARK_BEGIN="$OLD_BEGIN"; MARK_END="$OLD_END"; strip_block "$f"
    MARK_BEGIN="$MARK_BEGIN_SAVE"; MARK_END="$MARK_END_SAVE"
    say "migrated: removed the old errand-home block from $f"
  fi
done
# An earlier release used XDG_DATA_HOME even outside $HOME; carry its keys and ledger over.
XDG_OLD="${XDG_DATA_HOME:-}/ghless"
if [ -n "${XDG_DATA_HOME:-}" ] && [ "$XDG_OLD" != "$GHLESS_PREFIX" ] && [ -d "$XDG_OLD/data" ] && [ ! -e "$GHLESS_DATA/nostr.key" ] && [ -z "${USER_DATA:-}" ]; then
  cp -a "$XDG_OLD/data/." "$GHLESS_DATA/" && say "migrated: copied identities and ledger from $XDG_OLD/data (the old copy is kept)"
fi
for d in $SKILL_DIRS; do
  case "$(readlink "$d/errand-home" 2>/dev/null)" in */errand-home/*) rm -f "$d/errand-home"; say "migrated: removed $d/errand-home" ;; esac
done
if [ -d "$OLD_PREFIX/data" ] && [ ! -e "$GHLESS_DATA/nostr.key" ] && [ "$OLD_PREFIX" != "$GHLESS_PREFIX" ]; then
  cp -a "$OLD_PREFIX/data/." "$GHLESS_DATA/" && say "migrated: copied identities and ledger from $OLD_PREFIX/data (the old copy is kept)"
fi

# 3. Commands on PATH.
put_link() { # put_link NAME TARGET: only ever replaces links that are ours or dangling
  l="$GHLESS_BIN/$1"
  if [ -e "$l" ] || [ -L "$l" ]; then
    if [ ! -L "$l" ]; then
      warn "$l is a real file; left in place (move it, then re-run)"
      WARNED=1; return 1
    fi
    cur=$(readlink "$l"); inner="${2#"$GHLESS_HOME"}"; ours=0
    case "$cur" in "$GHLESS_HOME"/*|"$GHLESS_PREFIX"/*) ours=1 ;; esac
    [ "$ours" = 0 ] && [ "$inner" != "$2" ] && case "$cur" in *"$inner") ours=1; say "relinking $l (it pointed at another checkout: $cur)" ;; esac
    [ "$ours" = 0 ] && [ ! -e "$cur" ] && { ours=1; say "relinking $l (dangling link to $cur)"; }
    if [ "$ours" = 0 ]; then
      warn "$l is a link to $cur; left in place"
      WARNED=1; return 1
    fi
  fi
  ln -sfn "$2" "$l"
}
for n in $LINKS; do
  t=$(link_target "$n")
  [ -e "$t" ] || { warn "missing $t"; rc=1; continue; }
  put_link "$n" "$t" || rc=1
done
if [ "$GHSHIM" = 1 ]; then
  put_link gh "$(link_target gh)" || warn "gh wrapper not installed: your existing gh stays first"
fi
for b in cfrs pod-netns rad radicle-node git-remote-rad nak ngit git-remote-nostr git-remote-arweave arweave-git; do
  [ -x "$GHLESS_PREFIX/bin/$b" ] && { put_link "$b" "$GHLESS_PREFIX/bin/$b" || rc=1; }
done

# 4. PATH for future shells. env.sh is the one file to source from scripts and
# non-interactive agent shells; the profile block sources nothing else.
cat > "$GHLESS_PREFIX/env.sh" <<ENV
# ghless environment. Source this: . "$GHLESS_PREFIX/env.sh"
GHLESS_HOME="$GHLESS_HOME"
GHLESS_PREFIX="$GHLESS_PREFIX"
GHLESS_DATA="\${GHLESS_DATA:-$GHLESS_DATA}"
case ":\$PATH:" in ":$GHLESS_BIN:"*) ;; *) PATH="$GHLESS_BIN:\$PATH" ;; esac
export GHLESS_HOME GHLESS_PREFIX GHLESS_DATA PATH
ENV
if [ "$EDITPATH" = 1 ]; then
  for f in $(profile_files); do
    strip_block "$f" || { rc=1; continue; }
    [ -s "$f" ] && [ -n "$(tail -c1 "$f")" ] && printf '\n' >> "$f"
    {
      printf '%s\n' "$MARK_BEGIN"
      printf '[ -r "%s" ] && . "%s"\n' "$GHLESS_PREFIX/env.sh" "$GHLESS_PREFIX/env.sh"
      printf '%s\n' "$MARK_END"
    } >> "$f"
  done
fi

# 5. Skill registration (symlink, so the skill follows the checkout).
if [ "$SKILL" = 1 ]; then
  for d in $SKILL_DIRS; do
    mkdir -p "$d" && ln -sfn "$GHLESS_HOME/skill/ghless" "$d/ghless"
  done
fi

# 6. Prove it.
"$GHLESS_HOME/bin/ghless" doctor --brief || rc=1
if [ "$rc" = 0 ] && [ "$WARNED" = 1 ]; then
  say "installed with warnings (see above); the commands that were skipped keep their existing versions"
  say "In this shell: . \"$GHLESS_PREFIX/env.sh\""
elif [ "$rc" = 0 ]; then
  say "installed. In this shell: . \"$GHLESS_PREFIX/env.sh\"  (new login shells load it from ~/.profile)"
else
  say "finished with errors; see the messages above. Re-running ./install is safe."
fi
exit $rc
