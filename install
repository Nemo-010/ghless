#!/bin/sh
# install: one-time, idempotent setup of errand-home.
#
#   ./install [--core] [--no-gh-shim] [--no-skill] [--no-path] [--uninstall]
#             [--prefix DIR] [--bin DIR]
#
#   --core         system packages + cfrs only (skip radicle, nak, ngit, arweave)
#   --no-tools     system packages and links only; download no binaries
#   --no-gh-shim   do not put the gh-forge wrapper on PATH as `gh`
#   --no-skill     do not register SKILL.md with agent skill directories
#   --no-path      do not edit shell profiles
#   --uninstall    remove links, profile block and skill links (keeps data)
#
# Environment: ERRAND_PREFIX (binaries, default ~/.local/share/errand),
# ERRAND_BIN (links, default ~/.local/bin), ERRAND_DATA (state and work).
# Safe to re-run: every step checks before it acts.
set -u
ERRAND_HOME=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
export ERRAND_HOME
USER_DATA="${ERRAND_DATA:-}"; USER_WORK="${ERRAND_WORK:-}"
. "$ERRAND_HOME/libexec/common.sh"

CORE=0; GHSHIM=1; SKILL=1; EDITPATH=1; UNINSTALL=0; NOTOOLS=0; WARNED=0
while [ $# -gt 0 ]; do
  case "$1" in
    --prefix|--bin) [ $# -ge 2 ] || die "$1 needs a value" ;;
  esac
  case "$1" in
    --core) CORE=1 ;;
    --no-gh-shim) GHSHIM=0 ;;
    --no-skill) SKILL=0 ;;
    --no-path) EDITPATH=0 ;;
    --no-tools) NOTOOLS=1 ;;
    --uninstall) UNINSTALL=1 ;;
    --prefix) shift; ERRAND_PREFIX="$(abspath "$1")"; ERRAND_DATA="${USER_DATA:-$ERRAND_PREFIX/data}"; ERRAND_WORK="${USER_WORK:-$ERRAND_DATA/work}"; PATH="$ERRAND_PREFIX/bin:$PATH"; export ERRAND_PREFIX ERRAND_DATA ERRAND_WORK PATH ;;
    --bin) shift; ERRAND_BIN="$(abspath "$1")"; export ERRAND_BIN ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) die "unknown option: $1 (try --help)" ;;
  esac
  shift
done

MARK_BEGIN="# >>> errand-home >>>"
MARK_END="# <<< errand-home <<<"
SKILL_DIRS="$HOME/.claude/skills $HOME/.agents/skills"
LINKS="errand ghre ghre-hunt ghre-pack-patches ghre-export-records bulk-archive spn2 arquivo-apn megalodon ghostarchive archive-today urlscan socks-relay"

link_target() {
  case "$1" in
    errand) echo "$ERRAND_HOME/bin/errand" ;;
    ghre) echo "$ERRAND_HOME/components/ghre/bin/ghre" ;;
    ghre-hunt) echo "$ERRAND_HOME/components/ghre/bin/hunt" ;;
    ghre-pack-patches) echo "$ERRAND_HOME/components/ghre/bin/pack-patches" ;;
    ghre-export-records) echo "$ERRAND_HOME/components/ghre/bin/export-records" ;;
    bulk-archive) echo "$ERRAND_HOME/components/bulk-archive/bin/bulk-archive.sh" ;;
    spn2) echo "$ERRAND_HOME/components/bulk-archive/bin/spn2.sh" ;;
    arquivo-apn) echo "$ERRAND_HOME/components/bulk-archive/bin/arquivo-apn.sh" ;;
    megalodon) echo "$ERRAND_HOME/components/bulk-archive/bin/megalodon.sh" ;;
    ghostarchive) echo "$ERRAND_HOME/components/bulk-archive/bin/ghostarchive.sh" ;;
    archive-today) echo "$ERRAND_HOME/components/bulk-archive/bin/archive-today.sh" ;;
    urlscan) echo "$ERRAND_HOME/components/bulk-archive/bin/urlscan.sh" ;;
    socks-relay) echo "$ERRAND_HOME/reference/anonymous-git-hosting/scripts/socks-relay.py" ;;
    gh) echo "$ERRAND_HOME/components/gh-forge/bin/gh" ;;
  esac
}

profile_files() {
  for f in "$HOME/.profile" "$HOME/.bashrc" "$HOME/.zshrc"; do
    case "$f" in
      "$HOME/.profile"|"$HOME/.bashrc") echo "$f" ;;
      *) [ -f "$f" ] && echo "$f" ;;
    esac
  done
}

strip_block() { # strip_block FILE: removes only a well-formed block (BEGIN, then END, no BEGIN between)
  [ -f "$1" ] || return 0
  grep -qxF "$MARK_BEGIN" "$1" || return 0
  tmp="$1.errand.$$"
  awk -v b="$MARK_BEGIN" -v e="$MARK_END" '
    $0==b { if (open) printf "%s", buf; open=1; buf=$0 "\n"; next }
    $0==e && open { open=0; buf=""; next }
    open { buf = buf $0 "\n"; next }
    { print }
    END { if (open) { printf "%s", buf; exit 3 } }
  ' "$1" > "$tmp"
  rc_awk=$?
  if [ $rc_awk -eq 3 ]; then
    rm -f "$tmp"
    warn "$1 has a begin marker with no end marker; left untouched"
    return 1
  fi
  cat "$tmp" > "$1"; rm -f "$tmp"
}

if [ "$UNINSTALL" = 1 ]; then
  for n in $LINKS gh; do
    t=$(link_target "$n")
    [ "$(readlink "$ERRAND_BIN/$n" 2>/dev/null)" = "$t" ] && rm -f "$ERRAND_BIN/$n" && say "removed $ERRAND_BIN/$n"
  done
  for b in cfrs pod-netns rad radicle-node git-remote-rad nak ngit git-remote-nostr git-remote-arweave arweave-git; do
    [ "$(readlink "$ERRAND_BIN/$b" 2>/dev/null)" = "$ERRAND_PREFIX/bin/$b" ] && rm -f "$ERRAND_BIN/$b" && say "removed $ERRAND_BIN/$b"
  done
  for f in $(profile_files); do strip_block "$f"; done
  rm -f "$ERRAND_PREFIX/env.sh"
  for d in $SKILL_DIRS; do
    [ -L "$d/errand-home" ] && rm -f "$d/errand-home" && say "removed $d/errand-home"
  done
  say "uninstalled; data kept in $ERRAND_DATA, binaries kept in $ERRAND_PREFIX/bin"
  exit 0
fi

# 1. System packages. The package manager is detected, never assumed.
need=""
for pair in git:git curl:curl python3:python3 jq:jq unzip:unzip zip:zip tar:tar gzip:gzip xz:xz-utils sha256sum:coreutils; do
  have "${pair%%:*}" || need="$need ${pair#*:}"
done
have ssh || need="$need openssh-client"
have openssl || need="$need openssl"
if [ "$CORE" = 0 ]; then have go || need="$need golang-go"; fi
if [ -n "$need" ]; then
  SUDO=""; [ "$(id -u)" != 0 ] && have sudo && SUDO="sudo -n"
  if have apt-get; then
    say "installing system packages:$need"
    $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates $need >/dev/null 2>&1 ||
      { $SUDO env DEBIAN_FRONTEND=noninteractive apt-get update -qq >/dev/null 2>&1 &&
        $SUDO env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates $need >/dev/null; } ||
      warn "apt-get could not install:$need"
  elif have apk; then
    $SUDO apk add --no-cache git curl python3 jq unzip zip tar gzip xz openssl openssh-client go ca-certificates >/dev/null || warn "apk failed"
  elif have dnf; then
    $SUDO dnf install -y git curl python3 jq unzip zip tar gzip xz openssl openssh-clients golang ca-certificates >/dev/null || warn "dnf failed"
  elif have pacman; then
    $SUDO pacman -S --noconfirm --needed git curl python jq unzip zip tar gzip xz openssl openssh go >/dev/null || warn "pacman failed"
  else
    warn "no known package manager; install manually:$need"
  fi
fi
for must in git curl python3; do
  have "$must" || die "$must is required and could not be installed"
done

# 2. Pinned binaries. A tree unpacked without mode bits is repaired first.
chmod +x "$ERRAND_HOME/install" "$ERRAND_HOME/bin/errand" "$ERRAND_HOME"/libexec/* \
  "$ERRAND_HOME"/components/ghre/bin/* "$ERRAND_HOME"/components/bulk-archive/bin/* \
  "$ERRAND_HOME/components/gh-forge/bin/gh" "$ERRAND_HOME/reference/anonymous-git-hosting/scripts/socks-relay.py" 2>/dev/null
mkdir -p "$ERRAND_PREFIX/bin" "$ERRAND_DATA" "$ERRAND_WORK" "$ERRAND_BIN"
chmod 700 "$ERRAND_DATA" 2>/dev/null
rc=0
if [ "$NOTOOLS" = 1 ]; then
  :
elif [ "$CORE" = 1 ]; then
  "$ERRAND_HOME/libexec/tools" install cfrs || rc=1
else
  "$ERRAND_HOME/libexec/tools" install || rc=1
fi

# 3. Commands on PATH.
put_link() { # put_link NAME TARGET: never replaces a file that is not one of our links
  if [ -e "$ERRAND_BIN/$1" ] || [ -L "$ERRAND_BIN/$1" ]; then
    if [ ! -L "$ERRAND_BIN/$1" ]; then
      warn "$ERRAND_BIN/$1 is a real file; left in place (move it, then re-run)"
      WARNED=1; return 1
    fi
    case "$(readlink "$ERRAND_BIN/$1")" in
      "$ERRAND_HOME"/*|"$ERRAND_PREFIX"/*) ;;
      *) warn "$ERRAND_BIN/$1 is a link to $(readlink "$ERRAND_BIN/$1"); left in place"
         WARNED=1; return 1 ;;
    esac
  fi
  ln -sfn "$2" "$ERRAND_BIN/$1"
}
for n in $LINKS; do
  t=$(link_target "$n")
  [ -e "$t" ] || { warn "missing $t"; rc=1; continue; }
  put_link "$n" "$t" || rc=1
done
if [ "$GHSHIM" = 1 ]; then
  put_link gh "$(link_target gh)" || warn "gh wrapper not installed: your existing gh stays first"
fi
for b in cfrs pod-netns rad radicle-node git-remote-rad nak ngit git-remote-nostr git-remote-arweave arweave-git; do
  [ -x "$ERRAND_PREFIX/bin/$b" ] && { put_link "$b" "$ERRAND_PREFIX/bin/$b" || rc=1; }
done

# 4. PATH for future shells. env.sh is the one file to source from scripts and
# non-interactive agent shells; the profile block sources nothing else.
cat > "$ERRAND_PREFIX/env.sh" <<ENV
# errand-home environment. Source this: . "$ERRAND_PREFIX/env.sh"
ERRAND_HOME="$ERRAND_HOME"
ERRAND_PREFIX="$ERRAND_PREFIX"
ERRAND_DATA="\${ERRAND_DATA:-$ERRAND_DATA}"
case ":\$PATH:" in ":$ERRAND_BIN:"*) ;; *) PATH="$ERRAND_BIN:\$PATH" ;; esac
export ERRAND_HOME ERRAND_PREFIX ERRAND_DATA PATH
ENV
if [ "$EDITPATH" = 1 ]; then
  for f in $(profile_files); do
    strip_block "$f" || { rc=1; continue; }
    [ -s "$f" ] && [ -n "$(tail -c1 "$f")" ] && printf '\n' >> "$f"
    {
      printf '%s\n' "$MARK_BEGIN"
      printf '[ -r "%s" ] && . "%s"\n' "$ERRAND_PREFIX/env.sh" "$ERRAND_PREFIX/env.sh"
      printf '%s\n' "$MARK_END"
    } >> "$f"
  done
fi

# 5. Skill registration (symlink, so the skill follows the checkout).
if [ "$SKILL" = 1 ]; then
  for d in $SKILL_DIRS; do
    mkdir -p "$d" && ln -sfn "$ERRAND_HOME/skill/errand-home" "$d/errand-home"
  done
fi

# 6. Prove it.
"$ERRAND_HOME/bin/errand" doctor --brief || rc=1
if [ "$rc" = 0 ] && [ "$WARNED" = 1 ]; then
  say "installed with warnings (see above); the commands that were skipped keep their existing versions"
  say "In this shell: . \"$ERRAND_PREFIX/env.sh\""
elif [ "$rc" = 0 ]; then
  say "installed. In this shell: . \"$ERRAND_PREFIX/env.sh\"  (new login shells load it from ~/.profile)"
else
  say "finished with errors; see the messages above. Re-running ./install is safe."
fi
exit $rc
